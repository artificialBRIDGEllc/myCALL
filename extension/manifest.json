{
  "manifest_version": 3,
  "name": "myCALL - Medicare Call Intelligence",
  "version": "1.0.0",
  "description": "Automatically transcribe calls, extract Medicare enrollment data, and push to your CRM.",
  "permissions": ["tabCapture", "activeTab", "storage"],
  "host_permissions": ["https://*.deepgram.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "options_page": "setup.html",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "default_locale": "en"
}