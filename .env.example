# ---- myCALL server configuration ----
# Copy to .env (never commit .env) or set these in your hosting provider.

# Speech-to-text (Deepgram). Needed for audio uploads and live calls.
# Transcript uploads and the demo call work without it.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3          # or nova-3-medical for medical vocabulary
# DEEPGRAM_LANGUAGE=en-US
# DEEPGRAM_MIP_OPT_OUT=true     # keep call audio out of Deepgram model training (default)

# AI reviewer (Claude). Grades judgment skills, confirms paraphrased disclosures,
# writes summaries and coaching. Without it, calls are scored by phrase rules
# and judgment items are marked "needs review".
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5   # default; claude-sonnet-5-5 costs less per call
# CLAUDE_EFFORT=high             # low | medium | high | xhigh | max (default high)

# Shared access token. REQUIRED before exposing the server to the internet.
# The Docker image refuses to start without it (MYCALL_REQUIRE_TOKEN=true);
# set MYCALL_REQUIRE_TOKEN=false only for a local, keyless demo.
MYCALL_API_TOKEN=

# PORT=8787
# MYCALL_DATA_DIR=./data         # SQLite database + recordings (mount a volume here)
# MYCALL_MAX_UPLOAD_MB=200
